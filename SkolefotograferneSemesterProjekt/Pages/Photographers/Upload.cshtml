@page
@model SkolefotograferneSemesterProjekt.Pages.Photographers.UploadModel
@{
}

<div class="row">
    <div class="col-md-4">
        <form method="post" enctype="multipart/form-data">
            <label class="file">
                <input type="file" asp-for="fileUpload.Files" multiple aria-label="File browser example">
                <span class="file-custom"></span>
            </label>
            <input asp-page-handler="Upload" class="btn btn-primary" type="submit" value="Upload">
        </form>
    </div>
</div>
