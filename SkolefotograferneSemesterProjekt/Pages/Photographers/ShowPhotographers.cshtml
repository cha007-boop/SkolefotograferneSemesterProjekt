@page
@using SkolefotograferneSemesterProjekt.Models
@model SkolefotograferneSemesterProjekt.Pages.Photographers.ShowPhotographersModel
@{
	ViewData["Title"] = "Liste af Fotografer";
}


<h2>Liste over Fotografer</h2>

@if (HttpContext.Session.GetInt32("Role") == 4)
{
	<div style="text-align:right">
		<a asp-page="/Photographers/CreatePhotographer" class="btn btn-primary">Opret ny Fotograf</a>
	</div>
}

<form method="get">
	Søg: <input type="text" asp-for="@Model.FilterCriteria" />
	<select asp-for="@Model.FilterBy" class="form-select d-inline-block" style="width:auto; margin-left:8px;">
		<option value="All">Alle</option>
			<option value="FirstName">Fornavn</option>
			<option value="SurName">Efternavn</option>
			<option value="PhoneNumber">Telefonnummer</option>
			<option value="Mail">Email</option>
	</select>

	<input type="submit" value="Filtrer" />
</form>


<table class="table">
	<thead>
		<tr>
			<form method="get">
				<th>Fornavn</th>
			    <th>Efternavn</th>
			    <th>Telefonnummer</th>
			    <th>Email</th>
				<th></th>
			</form>
		</tr>
	</thead>
	<tbody>
		@foreach(Photographer photographer in Model.Photographers)
		{
			<tr>
				<td>@photographer.FirstName</td>
				<td>@photographer.Surname</td>
				<td>@photographer.PhoneNumber</td>
				<td>@photographer.Email</td>
				<td>
					<a asp-page="ViewPhotographer" asp-route-id="@photographer.ID" class="btn btn-primary">Vis mere info</a>
				</td>
			</tr>
		}
	</tbody>
</table>
<div>
	<a asp-page="/SysAdmins/ListOfAllUsers">Tilbage til brugeroversigt</a>
</div>