@page
@using SkolefotograferneSemesterProjekt.Models
@model SkolefotograferneSemesterProjekt.Pages.Photographers.ShowPhotographersModel
@{
	ViewData["Title"] = "List Photographers";
}


<h1>List of Photographers</h1>

@if (HttpContext.Session.GetInt32("Role") == 4)
{
	<div style="text-align:right">
		<a asp-page="/Photographers/CreatePhotographer" class="btn btn-primary">Opret ny Fotograf</a>
	</div>
}

<form method="get">
	search: <input type="text" asp-for="@Model.FilterCriteria" />
	<select asp-for="@Model.FilterBy" class="form-select d-inline-block" style="width:auto; margin-left:8px;">
		<option value="All">All</option>
			<option value="FirstName">FirstName</option>
			<option value="SurName">Surname</option>
			<option value="PhoneNumber">PhoneNumber</option>
			<option value="Mail">Mail</option>
	</select>

	<input type="submit" value="Filter" />
</form>


<table class="table">
	<thead>
		<tr>
			<form method="get">
				<th>firstname</th>
			    <th>surname</th>
			    <th>phonenumber</th>
			    <th>mail</th>
				<th></th>
			</form>
		</tr>
	</thead>
	<tbody>
		@foreach(Photographer photographer in Model.Photographers)
		{
			<tr>
				<td>@photographer.FirstName</td>
				<td>@photographer.Surname</td>
				<td>@photographer.PhoneNumber</td>
				<td>@photographer.Email</td>
				<td>
					<a asp-page="ViewPhotographer" asp-route-id="@photographer.ID" class="btn btn-primary">View more info</a>
				</td>
			</tr>
		}
	</tbody>
</table>
