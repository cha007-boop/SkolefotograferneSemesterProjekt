@page
@model SkolefotograferneSemesterProjekt.Pages.TeacherCRUD.CreateTeacherModel
@{
    ViewData["Title"] = "Create Teacher";
}
<h1>Opret bruger</h1>
<div class="form-group">
    <label asp-for="@Model.NewTeacher.FirstName" class="control-label"></label>
    <input asp-for="@Model.NewTeacher.FirstName" class="form-control" />
    <span asp-validation-for="@Model.NewTeacher.FirstName" class="text-danger"></span>
</div>
<div class="form-group">
    <label asp-for="@Model.NewTeacher.Surname" class="control-label"></label>
    <input asp-for="@Model.NewTeacher.Surname" class="form-control" />
    <span asp-validation-for="@Model.NewTeacher.Surname" class="text-danger"></span>
</div>
<div class="form-group">
    <label asp-for="@Model.NewTeacher.Email" class="control-label"></label>
    <input asp-for="@Model.NewTeacher.Email" class="form-control" />
    <span asp-validation-for="@Model.NewTeacher.Email" class="text-danger"></span>
</div>
<div class="form-group">
    <label asp-for="@Model.NewTeacher.PhoneNumber" class="control-label"></label>
    <input asp-for="@Model.NewTeacher.PhoneNumber" class="form-control" />
    <span asp-validation-for="@Model.NewTeacher.PhoneNumber" class="text-danger"></span>
</div>
<div class="form-group">
    <label asp-for="@Model.NewTeacher.SchoolID" class="control-label"></label>
    <input asp-for="@Model.NewTeacher.SchoolID" class="form-control" />
    <span asp-validation-for="@Model.NewTeacher.SchoolID" class="text-danger"></span>
</div>
<div class="form-group">
    <label asp-for="@Model.NewTeacher.Password" class="control-label"></label>
    <input asp-for="@Model.NewTeacher.Password" class="form-control" />
</div>
<div class="form-group">
    <input type="submit" value="Opret bruger" class="btn btn-primary" />
</div>
<div>
    <a asp-page="GetAllTeachers">Tilbage til listen af lærer </a>
</div>
