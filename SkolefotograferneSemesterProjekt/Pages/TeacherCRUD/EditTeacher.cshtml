@page
@model SkolefotograferneSemesterProjekt.Pages.TeacherCRUD.EditTeacherModel
@{
    ViewData["Title"] = "Opdater bruger";
}
<form method="post">
    <input type="hidden" asp-for="@Model.TeacherToEdit.ID" />
    <div class="form-group">

        <label asp-for="@Model.TeacherToEdit.FirstName" class="control-label"></label>
        <input asp-for="@Model.TeacherToEdit.FirstName" class="form-control" />
        <span asp-validation-for="@Model.TeacherToEdit.FirstName" class="text-danger"></span>
    </div>
    <div class="form-group">

        <label asp-for="@Model.TeacherToEdit.Surname" class="control-label"></label>
        <input asp-for="@Model.TeacherToEdit.Surname" class="form-control" />
        <span asp-validation-for="@Model.TeacherToEdit.Surname" class="text-danger"></span>
    </div>
    <div class="form-group">

        <label asp-for="@Model.TeacherToEdit.PhoneNumber" class="control-label"></label>
        <input asp-for="@Model.TeacherToEdit.PhoneNumber" class="form-control" />
        <span asp-validation-for="@Model.TeacherToEdit.PhoneNumber" class="text-danger"></span>
    </div>
    <div class="form-group">

        <label asp-for="@Model.TeacherToEdit.Email" class="control-label"></label>
        <input asp-for="@Model.TeacherToEdit.Email" class="form-control" />
        <span asp-validation-for="@Model.TeacherToEdit.Email" class="text-danger"></span>
    </div>

    <div class="form-group">
        <input type="submit" asp-route-id="@Model.TeacherToEdit.ID" value="Opdater bruger" class="btn btn-primary" />
    </div>
</form>
