@page
@model SkolefotograferneSemesterProjekt.Pages.SysAdmins.CreateSysAdminModel
@{
	ViewData["Title"] = "Signup as SysAdmin";
}


<h1>Signup</h1>

<form method="Post" enctype="multipart/form-data">
	<div asp-validation-summary="All" class="text-danger"></div>
	<div class="form-group">
		<label asp-for="@Model.NewSysAdmin.Email" class="control-label"></label>
		<input asp-for="@Model.NewSysAdmin.Email" class="form-control" />
		<span asp-validation-for="NewSysAdmin.Email" class="text-danger"></span>
	</div>
	<div class="form-group">
		<label asp-for="@Model.VerifyEmail" class="control-label"></label>
		<input asp-for="@Model.VerifyEmail" class="form-control" />
		<span asp-validation-for="NewSysAdmin.Email" class="text-danger"></span>
	</div>
	<div class="form-group">
		<label asp-for="@Model.NewSysAdmin.Password" class="control-label"></label>
		<input asp-for="@Model.NewSysAdmin.Password" class="form-control" id="Email"/>
		<span asp-validation-for="NewSysAdmin.Password" class="text-danger"></span>
	</div>
	<div class="form-group">
		<label asp-for="@Model.VerifyPassword" class="control-label"></label>
		<input asp-for="@Model.VerifyPassword" class="form-control" id="Password"/>
		<span asp-validation-for="NewSysAdmin.Password" class="text-danger"></span>
	</div>

	<div class="form-group">
		<input type="submit" value="Signup" class="btn-primary" />
	</div>

	<div>
		<a asp-page="index">Back to Homepage</a>
	</div>
	</form>