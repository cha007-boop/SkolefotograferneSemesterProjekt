@page
@using SkolefotograferneSemesterProjekt.Models
@model SkolefotograferneSemesterProjekt.Pages.SchoolClasses.ListSchoolCLassesModel
@{
	ViewData["Title"] = "List Classes";
}


<h1>Classes</h1>

<table class="table">
	<thead>
		<tr>
			<form method="get">
			<th>Grade</th>
			<th>Letter</th>
			<th>Year</th>
			</form>
		</tr>
	</thead>
	<tbody>
		@foreach (SchoolClass schoolClass in Model.SchoolClasses)
		{
			<tr>
				<td>@schoolClass.Grade</td>
				<td>@schoolClass.Letter</td>
				<td>@schoolClass.SchoolYear</td>
				<td>
					<a asp-page="UpdateSchoolClass" asp-route-id="@schoolClass.ID" class="btn btn-primary">Update/Edit</a>
				</td>
				<form method="Post">
				<td class="form-group">
					<input type="submit" asp-page-handler="Delete" asp-route-id="@schoolClass.ID" value="Delete SchoolClass" class="btn btn-danger" />
				</td>
				</form>
			</tr>
		}
	</tbody>
</table>
