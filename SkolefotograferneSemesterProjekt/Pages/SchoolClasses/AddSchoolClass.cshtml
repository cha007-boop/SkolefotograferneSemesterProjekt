@page
@model SkolefotograferneSemesterProjekt.Pages.SchoolClasses.AddSchoolClassModel
@{
    ViewData["Title"] = "Add new class";
}

<h1>Input class details</h1>

<form method="Post" enctype="multipart/form-data">
	<div asp-validation-summary="All" class="text-danger"></div>
	<div class="form-group">
		<label asp-for="@Model.NewSchoolClass.Grade" class="control-label"></label>
		<input asp-for="@Model.NewSchoolClass.Grade" class="form-control" />
		<span asp-validation-for="NewSchoolClass.Grade" class="text-danger"></span>
	</div>
	<div class="form-group">
		<label asp-for="@Model.NewSchoolClass.Letter" class="control-label"></label>
		<input asp-for="@Model.NewSchoolClass.Letter" class="form-control" />
	</div>

	<div class="form-group">
		<input type="submit" value="Create" class="btn-primary" />
	</div>

	<div>
		<a asp-page="index">Back to Homepage</a>
	</div>
</form>