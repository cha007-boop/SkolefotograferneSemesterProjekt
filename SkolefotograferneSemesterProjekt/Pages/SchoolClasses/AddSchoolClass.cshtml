@page
@model SkolefotograferneSemesterProjekt.Pages.SchoolClasses.AddSchoolClassModel
@{
    ViewData["Title"] = "Opret et nyt skoleklasse";
}

<h1>Input class details</h1>

@{int? userID = HttpContext.Session.GetInt32("ID");}
<div>
	<a asp-page="/Teachers/ViewSchoolClasses" asp-route-id="@userID">Tilbage</a>
</div>

<form method="Post" enctype="multipart/form-data">
	@* <div asp-validation-summary="All" class="text-danger"></div> *@
	<span asp-validation-for="Message" class="text-danger"></span>
	<div class="form-group">
		<label asp-for="@Model.NewSchoolClass.Grade" class="control-label"></label>
		<input asp-for="@Model.NewSchoolClass.Grade" class="form-control" />
		<span asp-validation-for="NewSchoolClass.Grade" class="text-danger"></span>
	</div>
	<div class="form-group">
		<label asp-for="@Model.NewSchoolClass.Letter" class="control-label"></label>
		<input asp-for="@Model.NewSchoolClass.Letter" class="form-control" />
		<span asp-validation-for="NewSchoolClass.Letter" class="text-danger"></span>
	</div>

	<div class="form-group d-flex gap-2 mt-3">
		<input type="submit" value="Create" class="btn-primary" />
		<a asp-page="/Teachers/ViewSchoolClasses" asp-route-id="@userID" class="btn btn-secondary">Fortryd</a>
	</div>
</form>