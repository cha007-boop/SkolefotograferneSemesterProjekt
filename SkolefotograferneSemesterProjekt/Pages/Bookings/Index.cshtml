@page
@using SkolefotograferneSemesterProjekt.Models
@model SkolefotograferneSemesterProjekt.Pages.Bookings.IndexModel
@{
	ViewData["Title"] = "Liste af PhotoEvents";
}

@if(Model.FilteredList.Count < 1)
{
	<h1>Der Findes ingen PhotoEvents...</h1>
}
else if (Model.Role == (int)UserRole.Teacher)
{
	<a asp-page="/Bookings/ListBookings">Se dine aktive bookinger</a>
	<table class="table">
		<thead>
			<tr>
				<th>Starttidspunkt</th>
				<th>Sluttidspunkt</th>
				<th>Lokation</th>
				<th></th>
			</tr>
		</thead>
		<tbody>
			@foreach (PhotoEvent pe in Model.FilteredList)
			{
				<tr>
					<td>@pe.StartTime</td>
					<td>@pe.EndTime</td>
					<td>@pe.Location</td>
					<td>
						<a asp-page="/Bookings/CreateBooking" asp-route-id="@pe.ID" class="btn btn-primary">Book</a>
					</td>
				</tr>
			}
		</tbody>
	</table>
}
else if (Model.Role == (int)UserRole.SchoolAdmin)
{
	<h1>Aktive PhotoEvents for @Model.ThisSchoolAdmin.TheSchool.Name</h1>

	<table class="table">
		<thead>
			<tr>
				<th>ID</th>
				<th>Starttidspunkt</th>
				<th>Sluttidspunkt</th>
				<th>Lokation</th>
			</tr>
		</thead>
		<tbody>
			@foreach (PhotoEvent pe in Model.FilteredList)
			{
				<tr>
					<td>@pe.ID</td>
					<td>@pe.StartTime</td>
					<td>@pe.EndTime</td>
					<td>@pe.Location</td>
				</tr>
			}
		</tbody>
	</table>
}
else if (Model.Role == (int)UserRole.SysAdmin)
{
	<h1>Aktive PhotoEvents for alle Skoler</h1>

	<table class="table">
		<thead>
			<tr>
				<th>ID</th>
				<th>Starttidspunkt</th>
				<th>Sluttidspunkt</th>
				<th>Lokation</th>
				<th>Skole ID</th>
				<th>Skole</th>
			</tr>
		</thead>
		<tbody>
			@foreach (PhotoEvent pe in Model.FilteredList)
			{
				<tr>
					<td>@pe.ID</td>
					<td>@pe.StartTime</td>
					<td>@pe.EndTime</td>
					<td>@pe.Location</td>
					<td>@pe.TheSchoolAdmin.TheSchool.ID</td>
					<td>@pe.TheSchoolAdmin.TheSchool.Name</td>
				</tr>
			}
		</tbody>
	</table>
}
else
{
	<h1>Der findes ingen PhotoEvents...</h1>
}