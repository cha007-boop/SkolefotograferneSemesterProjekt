@page
@using SkolefotograferneSemesterProjekt.Models
@model SkolefotograferneSemesterProjekt.Pages.Bookings.IndexModel
@{
	ViewData["Title"] = "Liste af Photo Events";
}
<h1>Bookings</h1>

@if (HttpContext.Session.GetInt32("Role") == 4)
{
	//add filter
}

@if (Model.PhotoEvents.Count >= 1)
{
	<table class="table">
		<thead>
			<tr>
				<form method="get">
				<th>Starttidspunkt</th>
				<th>Sluttidspunkt</th>
				<th>Lokation</th>
				</form>
			</tr>
		</thead>
		<tbody>
			@foreach (PhotoEvent pe in Model.FilteredList)
			{
				<tr>
					<td>@pe.StartTime</td>
					<td>@pe.EndTime</td>
					<td>@pe.Location</td>
					<td>
						<a asp-page="/Bookings/CreateBooking" asp-route-id="@pe.ID" class="btn btn-primary">Book</a>
					</td>
				</tr>
			}
		</tbody>
	</table>
}
else
{
	<h1>Der findes ingen PhotoEvents...</h1>
}