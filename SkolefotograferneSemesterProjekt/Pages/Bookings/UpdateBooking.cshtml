@page
@using SkolefotograferneSemesterProjekt.Models
@model SkolefotograferneSemesterProjekt.Pages.Bookings.UpdateBookingModel
@{
    ViewData["Title"] = "Liste af dine bookings";
}
<form method="post">
	<input type="hidden" asp-for ="@Model.TheClassBooking" />
	<input type="hidden" asp-for ="@Model.TheClassBooking.ID" />

	<div class="form-group">
		<label asp-for="@Model.TheClassBooking.StartTime" class="control-label">Starttidspunkt</label>
		<input asp-for="@Model.TheClassBooking.StartTime" class="form-control" />
		<span asp-validation-for="@Model.TheClassBooking.StartTime" class="text-danger"></span>
	</div>
    
	<div class="form-group">
		<input type="submit" value="Opdater booking" class="btn btn-primary" />
	</div>
</form>
	
<div>
	<a asp-page="Index">Tilbage</a>
</div>