@page
@using SkolefotograferneSemesterProjekt.Models
@model SkolefotograferneSemesterProjekt.Pages.Bookings.ListBookingsModel
@{
	ViewData["Title"] = "List of bookings";
}

@* @if(HttpContext.Session.GetInt32("Role") == 4)
{
	//add filter
} *@

@if (Model.Bookings.Count >= 1)
{
	<h1>Dine fotograferings bookinger</h1>
	<table class="table">
		<thead>
			<tr>
				<th>Starttidspunkt</th>
				<th>Klasse</th>
			</tr>
		</thead>
		<tbody>
			@foreach (ClassBooking classBooking in Model.Bookings)
			{
				<tr>
					<td>@classBooking.StartTime</td>
					<td>@(classBooking.TheSchoolClass.Grade + "." + classBooking.TheSchoolClass.Letter)</td>
					<td>
						<a asp-page="/Bookings/ViewBooking" asp-route-id="@classBooking.ID" class="btn btn-primary">View more info</a>
					</td>
					<td>
						<a asp-page="UpdateBooking" asp-route-id="@classBooking.ID">Opdater</a> |
						<a asp-page="DeleteBooking" asp-route-id="@classBooking.ID">Slet</a>
					</td>
				</tr>
			}
		</tbody>
	</table>	
}
else
{
	<a asp-page="Index">Tilbage</a>
	<h1>Du har ingen bookinger...</h1>
}
