@page
@using SkolefotograferneSemesterProjekt.Models
@model SkolefotograferneSemesterProjekt.Pages.SchoolAdmins.GetAllSchoolAdminModel
@{
    ViewData["Title"] = "Get All School Admin";
}

<div class="text-center">
    <h2 class="Display-3">List of School admins</h2>
</div>


<div class="mt-3">
    <form>
        <input type="hidden" asp-for=SortColumn />
        <input type="hidden" asp-for=SortOrder />
        search: <input type="text" asp-for="FilterValue" />
        <select asp-for="FilterColumn" class="form-select d-inline-block" style="width:auto; margin-left:8px;">
            <option value="All">-- Select Column --</option>
            @foreach (var column in Model.FilterableColumns)
            {
                <option value="@column.Key">@column.Value</option>
            }
        </select>
        <input type="submit" value="Search" />
    </form>
</div>

<div style="text-align:right">
    <button class="nav-item">
        <a class="nav-link text-dark" asp-area="" asp-page="/SchoolAdmins/CreateSchoolAdmin">Create</a>
    </button>
</div>

<div>
    <table class="table">
        <thead>
            <tr>
                @foreach (var column in Model.SortableColumns)
                {
                    <th>
                        <a asp-page="./GetAllSchoolAdmin"
                           asp-route-FilterColumn="@Model.FilterColumn"
                           asp-route-FilterValue="@Model.FilterValue"
                           asp-route-SortColumn="@column.Key"
                           asp-route-SortOrder="@Model.Toggle(column.Key)" class="text-decoration-none text-dark">
                            @column.Value @(Model.SortColumn == column.Key ? (Model.SortOrder == "ASC" ? "▲" : "▼") : "")
                        </a>
                    </th>
                }
            </tr>
        </thead>
        <tbody>
            @foreach (SchoolAdmin s in Model.SchoolAdmins)
            {
                <tr>
                    <td>@s.ID</td>
                    <td>@s.Email</td>
                    <td>@s.PhoneNumber</td>
                    <td>@s.ContactPerson</td>
                    <td>@s.TheSchool.Name</td>
                    <td>@s.TheSchool.Street</td>
                    <td>@s.TheSchool.ZipCode</td>
                    <td>@s.TheSchool.StudentCount</td>
                    @if (HttpContext.Session.GetInt32("Role") == 4)
                    {
                        <form method="post">
                        <td><button type="button" class="btn btn-danger" onclick="DisplayConfirmDeleteModal('@s.ID')">Delete</button></td>
                        </form>
                    }
                </tr>
            }
        </tbody>
    </table>
</div>


