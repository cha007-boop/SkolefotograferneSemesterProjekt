                <div class="form.group">
                    <label asp-for="@Model.ThisParent.Email" class="control-label"></label>
                    <input asp-for="@Model.ThisParent.Email" class="form-control" />
                    <span asp-validation-for="@Model.ThisParent.Email" class="text-danger"></span>
                </div>
            </div>
        </div>
        <div class="row" style="padding:5px">
            <div class="col-5">
                <div class="form.group">
                    <label asp-for="@Model.ThisParent.Password" class="control-label"></label>
                    <input asp-for="@Model.ThisParent.Password" class="form-control" />
                    <span asp-validation-for="@Model.ThisParent.Password" class="text-danger"></span>
                </div>
            </div>
            <div class="col-1"></div>
            <div class="col-5">
                <div class="form.group">
                    <label asp-for="@Model.VerifyPassword" class="control-label"></label>
                    <input asp-for="@Model.VerifyPassword" class="form-control" />
                    <span asp-validation-for="@Model.VerifyPassword" class="text-danger"></span>
                </div>
            </div>
        </div>
        <br />
        <p>You have registered @Model.Students.Count() child/children to you.</p>
        <br />
        <p>
            <a asp-page="/Students/CreateStudent">Add Child</a>
        </p>

        <table class="table">
            <thead>
                <tr>
                    <th>Child ID</th>
                    <th>Child First Name</th>
                    <th>Child Surname</th>
                    <th>Child School</th>
                    <th>Child Class</th>
                </tr>
            </thead>
            <tbody>
                @foreach (Student student in @Model.Students)
                {
                    <tr>
                        <td>@student.ID</td>
                        <td>@student.FirstName</td>
                        <td>@student.Surname</td>
                        <td>@student.TheSchoolClass.TheSchool.Name</td>
                        <td>@student.TheSchoolClass.Grade @student.TheSchoolClass.Letter</td>
                    </tr>
                }
            </tbody>
        </table>
        <p>
            @foreach (Student s in @Model.Students)
            {
            <p>
                Here you can see the pictures of your child @s.FirstName
                <a asp-page="/Parents/StudentPictures" asp-route-id="@s.ID">See Pictures</a>
                <br />
            </p>
        }
        </p>
    }
