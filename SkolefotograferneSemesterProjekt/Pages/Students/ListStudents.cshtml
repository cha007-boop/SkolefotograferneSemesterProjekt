@page
@using SkolefotograferneSemesterProjekt.Models
@model SkolefotograferneSemesterProjekt.Pages.Students.ListStudentsModel
@{
	ViewData["Title"] = "List Students";
}


<h1>Students</h1>


@if(HttpContext.Session.GetInt32("Role") == 1 || HttpContext.Session.GetInt32("Role") == 4)
{
	<form method="get">
	search:<input type="text" asp-for="@Model.FilterCriteria" />
	<select asp-for="@Model.FilterBy" class="form-select d-inline-block" style="width:auto; margin-left:8px;">
			<option value="FirstName">FirstName</option>
			<option value="SurName">Surname</option>
			<option value="TheSchool">School Name</option>
			@if(HttpContext.Session.GetInt32("Role") == 4)
			{
				<option value="TheParent">Parent ID</option>
			}
	</select>
		<input type="submit" value="Filter" />
	</form>
}


<table class="table">
	<thead>
		<tr>
			<form method="get">
			<th>Name</th>
			<th>Surname</th>
			<th>School Name</th>
			<th>Class</th>
			</form>
		</tr>
	</thead>
	<tbody>
		@foreach (Student student in Model.Students)
		{
			<tr>
				<td>@student.FirstName</td>
				<td>@student.Surname</td>
				<td>@student.TheSchool.Name</td>
				<td>@student.TheSchoolClass.Grade @student.TheSchoolClass.Letter</td>
				<td>
					@if (HttpContext.Session.GetInt32("Role") == 0)
					{
						<a asp-page="Students/UpdateStudent" asp-route-id="@student.ID" class="btn btn-primary">Update/Edit</a>
					}
					else
					{
						<a asp-page="Students/UpdateStudent" asp-route-id="@student.ID" class="btn btn-primary">View Student Info</a>
					}
				</td>
					<form method="post">
					<td><button type="button" class="btn btn-danger" onclick="DisplayConfirmDeleteModal('@student.ID')">Delete</button></td>
					</form>
			</tr>
		}
	</tbody>
</table>


<form method="post" asp-page-handler="Delete" id="deleteForm">
	<input type="hidden" name="id" id="deleteId" />
</form>

<div class="modal fade" id="deleteModalStudent" tabindex="-1">
	<div class="modal-dialog">
		<div class="modal-content">

			<div class="modal-header bg-warning">
				<h5 class="modal-title">Confirm Delete</h5>
				<button type="button" class="btn-close" data-bs-dismiss="modal"></button>
			</div>

			<div class="modal-body">
				<p>Are you sure you want to delete this Student?</p>
			</div>

			<div class="modal-footer">
				<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
					Cancel
				</button>

				<button type="button" class="btn btn-danger" id="confirmDeleteBtn">
					Delete
				</button>
			</div>

		</div>
	</div>

@section Scripts{
		<script>
			function DisplayConfirmDeleteModal(id) {
				document.getElementById("deleteId").value = id;

				var modal = new bootstrap.Modal(document.getElementById('deleteModalStudent'));
				modal.show();
			}

			document.getElementById("confirmDeleteBtn").addEventListener("click", function () {
				document.getElementById("deleteForm").submit();
			});
		</script>
}
