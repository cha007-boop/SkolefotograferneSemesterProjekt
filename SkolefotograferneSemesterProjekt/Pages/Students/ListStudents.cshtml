@page
@using SkolefotograferneSemesterProjekt.Models
@model SkolefotograferneSemesterProjekt.Pages.Students.ListStudentsModel
@{
    ViewData["Title"] = "Liste over elever";
}


<h1>Elever</h1>

@if (HttpContext.Session.GetInt32("Role") == 4)
{
    <form method="get">
        Søg:<input type="text" asp-for="@Model.FilterCriteria" />
        <select asp-for="@Model.FilterBy" class="form-select d-inline-block" style="width:auto; margin-left:8px;">
            <option value="FirstName">Fornavn</option>
            <option value="SurName">Efternavn</option>
            <option value="TheSchool">Skole</option>
            @if (HttpContext.Session.GetInt32("Role") == 4)
            {
                <option value="TheParent">Forælder ID</option>
            }
        </select>
        <input type="submit" value="Filter" />
    </form>
}


<table class="table">
    <thead>
        <tr>
            <form method="get">
            <th>Fornavn</th>
            <th>Efternavn</th>
            <th>Skole</th>
            <th>Klasse</th>
            </form>
        </tr>
    </thead>
    <tbody>
        @foreach (Student student in Model.Students)
        {
            <tr>
                <td>@student.FirstName</td>
                <td>@student.Surname</td>
                <td>@student.TheSchool.Name</td>
                <td>@student.TheSchoolClass.Grade @student.TheSchoolClass.Letter</td>
                <td>
                    @if (HttpContext.Session.GetInt32("Role") == 0)
                    {
                        <a asp-page="Students/UpdateStudent" asp-route-id="@student.ID" class="btn btn-primary">Opdater</a>
                    }
                    else
                    {
                        <a asp-page="Students/UpdateStudent" asp-route-id="@student.ID" class="btn btn-primary">Oplysninger</a>
                    }
                </td>
                <form method="post">
                <td><button type="button" class="btn btn-danger" onclick="DisplayConfirmDeleteModal('@student.ID')">Slet</button></td>
                </form>
            </tr>
        }
    </tbody>
</table>


<form method="post" asp-page-handler="Delete" id="deleteForm">
    <input type="hidden" name="id" id="deleteId" />
</form>

<div class="modal fade" id="deleteModalStudent" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">

            <div class="modal-header bg-warning">
                <h5 class="modal-title">Bekræft sletning</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <p>Er du sikker på, at du vil slette denne elev?</p>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    Annuller
                </button>

                <button type="button" class="btn btn-danger" id="confirmDeleteBtn">
                    Slet
                </button>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script>
        function DisplayConfirmDeleteModal(id) {
            document.getElementById("deleteId").value = id;

            var modal = new bootstrap.Modal(document.getElementById('deleteModalStudent'));
            modal.show();
        }

        document.getElementById("confirmDeleteBtn").addEventListener("click", function () {
            document.getElementById("deleteForm").submit();
        });
    </script>
}
