@page
@using SkolefotograferneSemesterProjekt.Models
@model SkolefotograferneSemesterProjekt.Pages.Students.ListStudentsModel
@{
	ViewData["Title"] = "List Students";
}


<h1>Students</h1>


@if(HttpContext.Session.GetInt32("Role") == 1 || HttpContext.Session.GetInt32("Role") == 4)
{
	<form method="get">
	search:<input type="text" asp-for="@Model.FilterCriteria" />
	<select asp-for="@Model.FilterBy" class="form-select d-inline-block" style="width:auto; margin-left:8px;">
			<option value="FirstName">FirstName</option>
			<option value="SurName">Surname</option>
			<option value="TheSchool">School Name</option>
			@if(HttpContext.Session.GetInt32("Role") == 4)
			{
				<option value="TheParent">Parent ID</option>
			}
	</select>
		<input type="submit" value="Filter" />
	</form>
}


<table class="table">
	<thead>
		<tr>
			<form method="get">
			<th>Name</th>
			<th>Surname</th>
			<th>School Name</th>
			<th>Class</th>
			</form>
		</tr>
	</thead>
	<tbody>
		@foreach (Student student in Model.Students)
		{
			<tr>
				<td>@student.FirstName</td>
				<td>@student.Surname</td>
				<td>@student.TheSchool.Name</td>
				<td>@student.TheSchoolClass.Grade @student.TheSchoolClass.Letter</td>
				<td>
					 <a asp-page="Students/UpdateStudent" asp-route-id="@student.ID" class="btn btn-primary">Update/Edit</a>
				</td>
				@if(HttpContext.Session.GetInt32("Role") == 0 || HttpContext.Session.GetInt32("Role") == 4)
				{
					<form method="Post">
				<td class="form-group">
					<input type="submit" asp-page-handler="Delete" asp-route-id="@student.ID" value="Delete Student" class="btn btn-danger" />
				</td>
				</form>
				}
			</tr>
		}
	</tbody>
</table>