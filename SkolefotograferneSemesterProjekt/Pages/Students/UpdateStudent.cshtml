@page
@model SkolefotograferneSemesterProjekt.Pages.Students.UpdateStudentModel
@{
	if (HttpContext.Session.GetInt32("Role") == 0)
		ViewData["Title"] = "Update Student";
	else
		ViewData["Title"] = "View Student Details";
}


@if(HttpContext.Session.GetInt32("Role") == 0)
{
<form method="Post" enctype="multipart/form-data">
	<div class="form-group">
		<label asp-for="@Model.NewStudent.FirstName" class="control-label"></label>
		<input asp-for="@Model.NewStudent.FirstName" class="form-control" />
	</div>
	<div class="form-group">
		<label asp-for="@Model.NewStudent.Surname" class="control-label"></label>
		<input asp-for="@Model.NewStudent.Surname" class="form-control" />
	</div>
	<div class="form-group">
		<label asp-for="@Model.NewStudent.TheSchool.ID" class="control-label"></label>
		<select asp-for="@Model.SchoolID"
				asp-items="Model.Schools"
				id="schoolSelect"
				class="form-select">
			<option value="">-- Select School --</option>
		</select>
	</div>
	<div class="form-group">
		<label asp-for="@Model.ClassGrade" class="control-label"></label>
		<input asp-for="@Model.ClassGrade" class="form-control" min="0" max="10"/>
		<span asp-validation-for="ClassGrade" class="text-danger"></span>
	</div>
	<div class="form-group">
		<label asp-for="@Model.ClassLetter" class="control-label"></label>
		<input asp-for="@Model.ClassLetter" class="form-control" />
			<span asp-validation-for="ClassLetter" class="text-danger"></span>
	</div>
		<div class="form-group">
			<input type="submit" asp-page-handler="Update" value="Update" class="btn btn-primary" />
		</div>
	</form>
	<div>
		<a asp-page="/Users/EditProfile">Return</a>
	</div>
}
else
{
	<h1>Student Information</h1>

	<p>First Name: @Model.NewStudent.FirstName</p>
	<p>Surname: @Model.NewStudent.Surname</p>
	@if(HttpContext.Session.GetInt32("Role") == 4)
	{
		<p>Parent ID: @Model.NewStudent.TheParent.ID</p>
	}
	<p>School: @Model.NewStudent.TheSchool.Name</p>
	<p>Class: @Model.NewStudent.TheSchoolClass.Grade @Model.NewStudent.TheSchoolClass.Letter</p>

	<form>
	<div>
	<a asp-page="Students/ListStudents">Back to List of Students</a>
	</div>
	</form>
}
