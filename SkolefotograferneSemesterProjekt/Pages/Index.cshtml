@page
@using SkolefotograferneSemesterProjekt.Models
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}

<div class="form-group">
@if (HttpContext.Session.GetInt32("ID") == null)
{

        <div class="container-md">

            <div style="background-color:#f1e9d2" id="carouselExampleIndicators" class="carousel slide" data-bs-ride="carousel">
                <ol class="carousel-indicators">
                    @for (int i = 0; i < 5; i++)
                    {
                        <li data-bs-target="#carouselExampleIndicators" data-bs-slide-to="@i" class="@(i == 0 ? "active" : "")"></li>
                    }
                </ol>
                <div class="carousel-inner">
                    <div class="carousel-item active">
                        <img style="margin: auto; height:400px; width:auto" class="d-block" src="~/images/FrontWebPhotos/One_Girl.jpg" alt="Slide">
                    </div>
                    <div class="carousel-item">
                        <img style="margin: auto; height:400px; width:auto" class="d-block" src="~/images/FrontWebPhotos/Drawing2.jpeg" alt="Slide">
                    </div>
                    <div class="carousel-item">
                        <img style="margin: auto; height:400px; width:auto" class="d-block" src="~/images/FrontWebPhotos/Man_3.jpg" alt="Slide">
                    </div>
                    <div class="carousel-item">
                        <img style="margin: auto; height:400px; width:auto" class="d-block" src="~/images/FrontWebPhotos/Girl_Side4.jpg" alt="Slide">
                    </div>
                    <div class="carousel-item">
                        <img style="margin: auto; height:400px; width:auto" class="d-block" src="~/images/FrontWebPhotos/Old_Man5.jpg" alt="Slide">
                    </div>
                </div>
                <a class="carousel-control-prev custom-carousel-control" href="#carouselExampleIndicators" role="button" style="color:#c1b38d" data-bs-slide="prev">
                    <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                    @* <span class="sr-only" style="color:black">Previous</span> *@
                </a>
                <a class="carousel-control-next custom-carousel-control" href="#carouselExampleIndicators" role="button" style="color:#c1b38d" data-bs-slide="next">
                    @* <span class="sr-only" style="color:black">Next</span> *@
                    <span class="carousel-control-next-icon" aria-hidden="true"></span>
                </a>
                @* OG
                <a class="carousel-control-prev" href="#carouselExampleIndicators" role="button" style="color:darkgrey" data-bs-slide="prev">
                    <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                    <span class="sr-only" style="color:black" >Previous</span>
                </a>
                <a class="carousel-control-next" href="#carouselExampleIndicators" role="button" style="color:darkgrey" data-bs-slide="next">
                    <span class="sr-only" style="color:black" >Next</span>
                    <span class="carousel-control-next-icon" aria-hidden="true"></span>
                </a> *@
            </div>
        </div>
        <br />
        <br />
        <div style="text-align:center">
            <h1 style="color:#7a6e4a">Velkommen til SkoleFoto</h1>
        </div>
        <br />
        <br />
        <div class="container-md">
            <div class="row" style="display:flex; flex-wrap:wrap">
                <div class="column" style="flex:10%"></div>
                <div class="column" style="flex:35%; padding: 14px; border: 2px solid #c1b38d; text-align:center">
                    <div>
                        <img style="height:300px; width:auto; margin:auto;" src="~/images/FrontWebPhotos/Drawing2.jpeg" alt="Some other picture" />
                        <p>
                            <h4>First Header</h4>
                            Here you can write som random text about something anyone can know. No secrets allowed.
                        </p>
                    </div>
                </div>
                <div class="column" style="flex:10%"></div>
                <div class="column" style="flex:35%; padding: 25px; border: 2px solid #c1b38d; text-align:center">
                    <div>
                        <img style="height:300px; width:auto; margin:auto" src="~/images/FrontWebPhotos/Man_3.jpg" alt="Some other picture" />
                        <p>
                            <h4>Second Header</h4>
                            Here you can write som random text about something anyone can know. No secrets allowed.
                            i have no idea what to write id was more a test to se if this one goes further down would the other one as well.
                        </p>
                    </div>
                </div>
                <div class="column" style="flex:10%"></div>
            </div>
        </div>
        <br />
        <br />

}
@if (HttpContext.Session.GetInt32("Role") == 0)
{

        <h1 style="color:#362e19">Velkommen Forælder</h1>
        <br />
        <div class="row" style="display:flex">

            <div class="col" style="flex: 30%">
                <a asp-page="/Students/createStudent" class="text-decoration-none">
                    <div class="text-white" style="border: 2px solid #7a6e4a;padding: 30px; text-align:center; background-color:#7a6e4a">
                        Tilføj Barn
                    </div>
                </a>
            </div>
            <div class="column" style="flex:2%"></div>
            <div class="col" style="flex: 30%">
                <a asp-page="/Parents/ListOfChildren" asp-route-id="@HttpContext.Session.GetInt32("ID")" class="text-decoration-none">
                    <div class="text-white" style="border: 2px solid #7a6e4a; padding: 30px; text-align:center; background-color:#7a6e4a">
                        Se alle Børn
                    </div>
                </a>
            </div>
            <div class="column" style="flex:2%"></div>
            <div class="col" style="flex: 30%">
                <a asp-page="/Users/EditProfile" asp-route-id="@HttpContext.Session.GetInt32("ID")" class="text-decoration-none">
                    <div class="text-white" style="border: 2px solid #7a6e4a; padding: 30px; text-align:center; background-color:#7a6e4a">
                        Rediger Profil
                    </div>
                </a>
            </div>
        </div>
        <br />
        <div class="row" style="display:flex">
            <div class="col" style="flex: 30%">
                <a asp-page="/PhotoEvents/ReadPhotoEvents" class="text-decoration-none">
                    <div class="text-white" style="border: 2px solid #7a6e4a; padding: 30px; text-align:center; background-color:#7a6e4a">
                        Se alle FotoEvents for dit barn/dine børn
                    </div>
                </a>
            </div>
            @* <div class="column" style="flex:2%"></div>
            <div class="col" style="flex: 30%; border: 2px solid darkgrey; padding: 30px; text-align:center">
                <p>tilføj noget tekst her</p>
            </div>
            <div class="column" style="flex:2%"></div>
            <div class="col" style="flex: 30%; border: 2px solid darkgrey; padding: 30px; text-align:center">
                <p>tilføj noget tekst her</p>
            </div> *@
        </div>

}
