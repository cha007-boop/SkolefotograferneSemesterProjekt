@page
@using SkolefotograferneSemesterProjekt.Models
@model SkolefotograferneSemesterProjekt.Pages.Schools.GetAllSchoolModel
@{
    ViewData["Title"] = "Get All Schools";
}

<div class="text-center">
    <h2 class="Display-3">List of School admins</h2>
</div>

<div>
    <button class="nav-item">
        <a class="nav-link text-dark" asp-area="" asp-page="/Schools/CreateSchool">Create</a>
    </button>
</div>

<div class="mt-3">
    <form>
        <input type="hidden" asp-for=SortColumn />
        <input type="hidden" asp-for=SortOrder />
        search: <input type="text" asp-for="FilterValue" />
        <select asp-for="FilterColumn" class="form-select d-inline-block" style="width:auto; margin-left:8px;">
            <option value="All">-- Select Column --</option>
            @foreach(var column in Model.FilterableColumns)
            {
                <option value="@column.Key">@column.Value</option>
            }
        </select>
        <input type="submit" value="Search" />
    </form>
</div>

<div>
    <table class="table">
        <thead>
            <tr>
                @foreach (var column in Model.FilterableColumns)
                {
                    <th>
                        <a asp-page="./GetAllSchool"
                           asp-route-FilterColumn="@Model.FilterColumn"
                           asp-route-FilterValue="@Model.FilterValue"
                           asp-route-SortColumn="@column.Key"
                           asp-route-SortOrder="@Model.Toggle(column.Key)" class="text-decoration-none text-dark">
                            @column.Value @(Model.SortColumn == column.Key ? (Model.SortOrder == "ASC" ? "▲" : "▼") : "")
                        </a>
                    </th>
                }
            </tr>
        </thead>
        <tbody>
            @foreach (School s in Model.Schools)
            {
                <tr>
                    @foreach(var column in Model.FilterableColumns)
                    {
                        <td>
                            @typeof(School).GetProperty(column.Key).GetValue(s)
                        </td>
                    }
                    @if (HttpContext.Session.GetInt32("Role") == 4)
                    {
                        <form method="post">
                            <input type="hidden" asp-for="SortColumn" />
                            <input type="hidden" asp-for="SortOrder" />
                            <input type="hidden" asp-for="Schools" />
                        <td><button type="button" class="btn btn-danger" asp-route-id="@s.ID" onclick="DisplayConfirmDeleteModal('@s.ID')">Delete</button></td>
                        </form>
                        <td><a asp-page="/Schools/UpdateSchool" asp-route-id="@s.ID" class="btn btn-primary">Update school</a></td>
                    }
                </tr>
                
                @* <tr>
                    <td>@s.ID</td>
                    <td>@s.Name</td>
                    <td>@s.Street</td>
                    <td>@s.ZipCode</td>
                    <td>@s.Country</td>
                    <td>@s.StudentCount</td>
                </tr> *@
            }
        </tbody>
    </table>
</div>


<form method="post" asp-page-handler="Delete" id="deleteForm">
    <input type="hidden" name="id" id="deleteId" />
</form>

<div class="modal fade" id="deleteModalSchool" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">

            <div class="modal-header bg-warning">
                <h5 class="modal-title">Confirm Delete</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <p>Are you sure you want to delete this school?</p>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    Cancel
                </button>

                <button type="button" class="btn btn-danger" id="confirmDeleteBtn">
                    Delete
                </button>
            </div>

        </div>
    </div>

@section Scripts{
        <script>
            function DisplayConfirmDeleteModal(id) {
                document.getElementById("deleteId").value = id;

                var modal = new bootstrap.Modal(document.getElementById('deleteModalSchool'));
                modal.show();
            }

            document.getElementById("confirmDeleteBtn").addEventListener("click", function () {
                document.getElementById("deleteForm").submit();
            });
        </script>
}
