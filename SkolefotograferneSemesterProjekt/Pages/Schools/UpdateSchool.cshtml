@page
@model SkolefotograferneSemesterProjekt.Pages.Schools.UpdateSchoolModel
@{
	ViewData["Title"] = "Opdater skole";
}


<h1>Opdater oplysningerne for skolen @Model.NewSchool.Name</h1>

<form method="post" enctype="multipart/form-data">
	<input hidden asp-for="@Model.NewSchool.ID" />

	<div class="form-group">
		<label asp-for="@Model.NewSchool.Name" class="control-label"></label>
		<input asp-for="@Model.NewSchool.Name" class="form-control" />
		<span asp-validation-for="NewSchool.Name" class="text-danger"></span>
	</div>
	<div class="form-group">
		<label asp-for="@Model.NewSchool.StudentCount" class="control-label"></label>
		<input asp-for="@Model.NewSchool.StudentCount" class="form-control" />
		<span asp-validation-for="NewSchool.StudentCount" class="text-danger"></span>
	</div>
	<div class="form-group">
		<label asp-for="@Model.NewSchool.Street" class="control-label"></label>
		<input asp-for="@Model.NewSchool.Street" class="form-control" />
		<span asp-validation-for="NewSchool.Street" class="text-danger"></span>
	</div>
	<div class="form-group">
		<label asp-for="@Model.NewSchool.ZipCode" class="control-label"></label>
		<input asp-for="@Model.NewSchool.ZipCode" class="form-control" />
		<span asp-validation-for="NewSchool.ZipCode" class="text-danger"></span>
	</div>
	<div class="form-group">
		<label asp-for="@Model.NewSchool.Country" class="control-label"></label>
		<input asp-for="@Model.NewSchool.Country" class="form-control" />
		<span asp-validation-for="NewSchool.Country" class="text-danger"></span>
	</div>
	<div class="form-group">
		<input type="submit" asp-page-handler="Update" value="Update" class="btn btn-primary" />
	</div>
</form>
<div>
	<a asp-page="/Schools/GetAllSchool">Tilbage</a>
</div>