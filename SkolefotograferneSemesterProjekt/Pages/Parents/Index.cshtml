@page
@using SkolefotograferneSemesterProjekt.Models
@model SkolefotograferneSemesterProjekt.Pages.Parents.IndexModel
@{
    ViewData["Title"] = "Forældre";
}


<h2>Liste over forældre</h2>
<form>
    Søg: <input type="text" asp-for="@Model.Filter" />
    <input type="submit" value="Filtrer" />
</form>

@if (HttpContext.Session.GetInt32("Role") == 4)
{
    <div style="text-align:right">
        <a asp-page="/Parents/CreateParent" class="btn btn-primary">Opret ny Forældre</a>
    </div>
}

<table class="table">
    <thead>
        <tr>
            <form method="get">
            @* <th>Firstname</th> *@
            <th>
                <a asp-page="Index" 
                asp-route-SortBy="FirstName" 
                asp-route-SortOrder="@Model.Toggle("FirstName")"
                asp-route-Filter="@Model.Filter"
                class="text-decoration-none text-dark" name="SortBy" value="FirstName">Fornavn
                    @(Model.SortBy == "FirstName" ? (Model.SortOrder == "asc" ? "▲" : "▼") : "")
                </a>
            </th>
            @* <th>Surname</th> *@
            <th>
                <a asp-page="Index"
                   asp-route-SortBy="Surname"
                   asp-route-SortOrder="@Model.Toggle("Surname")"
                   asp-route-Filter="@Model.Filter"
                   class="text-decoration-none text-dark" name="SortBy" value="Surname">
                    Efternavn
                    @(Model.SortBy == "Surname" ? (Model.SortOrder == "asc" ? "▲" : "▼") : "")
                </a>
            </th>
            @* <th>PhoneNumber</th> *@
            <th>
                <a asp-page="Index"
                   asp-route-SortBy="PhoneNumber"
                   asp-route-SortOrder="@Model.Toggle("PhoneNumber")"
                   asp-route-Filter="@Model.Filter"
                   class="text-decoration-none text-dark" name="SortBy" value="PhotoNumber">
                    Telefon
                    @(Model.SortBy == "PhoneNumber" ? (Model.SortOrder == "asc" ? "▲" : "▼") : "")
                </a>
            </th>
            <th>Email</th>
            <th></th>
            </form>
        </tr>
    </thead>
    <tbody>
        @foreach(Parent p in Model.Parents)
        {
            <tr>
                <td>@p.FirstName</td>
                <td>@p.Surname</td>
                <td>@p.PhoneNumber</td>
                <td>@p.Email</td>
                <td>
                    <a asp-page="ParentInformation" asp-route-ID="@p.ID">Mere information</a>
                </td>
            </tr>
        }
    </tbody>
</table>