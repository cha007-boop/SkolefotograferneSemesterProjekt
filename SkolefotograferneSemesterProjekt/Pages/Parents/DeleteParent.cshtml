@page
@model SkolefotograferneSemesterProjekt.Pages.Parents.DeleteParentModel
@{
    ViewData["Title"] = "Delete Parent";
}

<h1>Delete </h1>

<h4>Are you sure you want to delete Your Profile</h4>
<p>
    @Model.ParentToDelete.FirstName @Model.ParentToDelete.Surname
</p>
<div>
    <input type="submit" asp-page-handler="Delete" 
    value="Delete Profile" class="btn btn-danger" />
    <input type="submit" value="Cancel" class="btn btn-warning" />
</div>
