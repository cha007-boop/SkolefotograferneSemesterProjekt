@page
@using SkolefotograferneSemesterProjekt.Models
@model SkolefotograferneSemesterProjekt.Pages.Parents.ParentInformationModel
@{
    ViewData["Title"] = "Parent Information";
}


<h1>Welcome @Model.Parent.FirstName</h1>

<p style="text-align:right">
    <a asp-page="/Parents/EditParent">Edit Parent Information</a>
</p>


<form class="d-inline-block">
    <label for="First Name">First Name: </label>
    <input type="text" id="First Name" name="First Name" value="@Model.Parent.FirstName" readonly style="padding:15px" />
    <label for="Surname">Surname: </label>
    <input type="text" id="Surname" name="Surname" value="@Model.Parent.Surname" readonly />
    <br/>
    <br />
    <label for="PhoneNumber">PhoneNumber: </label>
    <input type="text" id="PhoneNumber" name="PhoneNumber" value="@Model.Parent.PhoneNumber" readonly style="padding:15px" />
    <label for="Email">Email: </label>
    <input type="text" id="Email" name="Email" value="@Model.Parent.Email" readonly />
    <br/>
    You have registered @Model.Students.Count() child/children to you. <br/>
</form>
<br />
<p>
    <a asp-page="/Students/CreateStudent">Add Child</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Child ID</th>
            <th>Child First Name</th>
            <th>Child Surname</th>
            <th>Child School</th>
            <th>Child Class</th>
        </tr>
    </thead>
    <tbody>
        @foreach (Student student in @Model.Students)
        {
            <tr>
                <td>@student.ID</td>
                <td>@student.FirstName</td>
                <td>@student.Surname</td>
                <td>@student.TheSchool.Name</td>
                <td>@student.TheSchoolClass.Grade @student.TheSchoolClass.Letter</td>
            </tr>
        }
    </tbody>
</table>
<p>
    @foreach (Student s in @Model.Students)
    {
        <p>
        Here you can see the pictures of your child @s.FirstName 
        <a asp-page="/Parents/StudentPictures" asp-route-id="@s.ID">See Pictures</a>
        <br/>
        </p>
    }
</p>

