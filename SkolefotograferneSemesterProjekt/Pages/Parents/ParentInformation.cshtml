@page
@using SkolefotograferneSemesterProjekt.Models
@model SkolefotograferneSemesterProjekt.Pages.Parents.ParentInformationModel
@{
    ViewData["Title"] = "Forælder oplysninger";
}


<h1>Velkommen @Model.Parent.FirstName</h1>
@if (HttpContext.Session.GetInt32("Role") == (int)UserRole.Parent)
{
    <p style="text-align:right">
        <a asp-page="/Users/EditProfile">Rediger oplysninger</a>
    </p>
}


<div class="row" style="padding:5px">
    <div class="col-5">
        <div class="form.group">
            <label asp-for="@Model.Parent.FirstName" class="control-label"></label>
            <input asp-for="@Model.Parent.FirstName" class="form-control" readonly style="padding:15px" />
        </div>
    </div>
    <div class="col-1"></div>
    <div class="col-5">
        <div class="form.group">
            <label asp-for="@Model.Parent.Surname" class="control-label"></label>
            <input asp-for="@Model.Parent.Surname" class="form-control" readonly style="padding:15px" />
        </div>
    </div>
</div>

<div class="row" style="padding:5px">
    <div class="col-5">
        <div class="form.group">
            <label asp-for="@Model.Parent.PhoneNumber" class="control-label"></label>
            <input asp-for="@Model.Parent.PhoneNumber" class="form-control" readonly style="padding:15px" />
        </div>
    </div>
    <div class="col-1"></div>
    <div class="col-5">
        <div class="form.group">
            <label asp-for="@Model.Parent.Email" class="control-label"></label>
            <input asp-for="@Model.Parent.Email" class="form-control" readonly style="padding:15px" />
        </div>
    </div>
</div>
@if (HttpContext.Session.GetInt32("Role") == (int)UserRole.Parent)
{
<br />
    <p>Du har registreret @Model.Students.Count() barn/børn til dig.</p>
<br />
<br />
<p>
    <a asp-page="/Students/CreateStudent">Tilføj barn</a>
</p>
}

<table class="table">
    <thead>
        <tr>
            <th>Barn ID</th>
            <th>Barn Fornavn</th>
            <th>Barn Efternavn</th>
            <th>Barn Skole</th>
            <th>Barn Klasse</th>
        </tr>
    </thead>
    <tbody>
        @foreach (Student student in @Model.Students)
        {
            <tr>
                <td>@student.ID</td>
                <td>@student.FirstName</td>
                <td>@student.Surname</td>
                <td>@student.TheSchoolClass.TheSchool.Name</td>
                <td>@student.TheSchoolClass.Grade @student.TheSchoolClass.Letter</td>
            </tr>
        }
    </tbody>
</table>
<p>
    @foreach (Student s in @Model.Students)
    {
    <p>
        Her kan du se billederne af dit barn @s.FirstName
        <a asp-page="/Parents/StudentPictures" asp-route-id="@s.ID">Se billeder</a>
        <br />
    </p>
    }
</p>

