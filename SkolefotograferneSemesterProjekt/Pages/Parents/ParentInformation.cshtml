@page
@using SkolefotograferneSemesterProjekt.Models
@model SkolefotograferneSemesterProjekt.Pages.Parents.ParentInformationModel
@{
    ViewData["Title"] = "Parent Information";
}


<h1>Welcome @Model.Parent.FirstName</h1>

<table class="table">
    <thead>
        <tr>
            <th>Child ID</th>
            <th>Child First Name</th>
            <th>Child Surname</th>
            <th>Child School</th>
            <th>Child Class</th>
        </tr>
    </thead>
    <tbody>
        @foreach (Student student in @Model.Students)
        {
            <tr>
                <td>@student.ID</td>
                <td>@student.FirstName</td>
                <td>@student.Surname</td>
                @foreach (School school in Model.Schools)
                {
                    if(school.ID == student.SchoolID)
                    {
                        <td>@school.Name</td>
                    }
                }
                @foreach (SchoolClass classes in Model.Classes)
                {
                    @if(classes.ID == student.ClassID)
                    {
                        <td>@classes.Grade @classes.Letter</td>
                    }
                }
            </tr>
        }
    </tbody>
</table>