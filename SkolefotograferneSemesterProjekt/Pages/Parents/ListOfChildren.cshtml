@page
@using SkolefotograferneSemesterProjekt.Models
@model SkolefotograferneSemesterProjekt.Pages.Parents.ListOfChildrenModel
@{
    ViewData["Title"] = "Liste over børn";
}

<h1>Liste over børn</h1>

<p>
    <a asp-page="/Students/CreateStudent" class="btn btn-primary">Tilføj Barn</a>
</p>

@if (Model.Students.Count <= 0)
{
    <p class="display-6">Du har endnu ikke registreret nogle børn til din konto</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Barns ID</th>
                <th>Fornavn</th>
                <th>Efternavn</th>
                <th>Skole</th>
                <th>Klasse</th>
                <th>Billeder</th>
            </tr>
        </thead>
        <tbody>
            @foreach (Student student in @Model.Students)
            {
                <tr>
                    <td>@student.ID</td>
                    <td>@student.FirstName</td>
                    <td>@student.Surname</td>
                    <td>@student.TheSchoolClass.TheSchool.Name</td>
                    <td>@student.TheSchoolClass.Grade @student.TheSchoolClass.Letter</td>
                    <td>
                        <a asp-page="/Parents/StudentPictures" asp-route-id="@student.ID">Se billeder</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<div>
    <a asp-page="/Index">Tilbage til forsiden</a>
</div>