@page
@using SkolefotograferneSemesterProjekt.Models
@model SkolefotograferneSemesterProjekt.Pages.Parents.StudentPicturesModel
@{
    ViewData["Title"] = "Se billeder";
}

<div>
    <a asp-page="/Students/ListStudents">Tilbage til liste af børn</a>
</div>

<h2> Billeder af @Model.TheStudent.FirstName </h2>

@if (HttpContext.Session.GetInt32("Role") != (int)UserRole.Parent)
{
    <p>
        Tilhører forældren @Model.TheParent.FirstName med email @Model.TheParent.Email <br />
    </p>
}

<div class="container-md">

    <div style="background-color:beige" id="carouselExampleIndicators" class="carousel slide" data-bs-ride="carousel">
        <ol class="carousel-indicators">
            @for (int i = 0; i < 5; i++)
            {
                <li data-bs-target="#carouselExampleIndicators" data-bs-slide-to="@i" class="@(i == 0 ? "active" : "")"></li>
            }
        </ol>
        <div class="carousel-inner">
            @foreach (Photo p in @Model.Photos)
            {
                <div class="carousel-item @(p == Model.Photos.First() ? "active" : "")">
                    <img style="margin: auto; height:400px; width:auto" class="d-block" src="~/images/Portraits/@p.Filename" alt="Slide">
                </div>
            }

        </div>
        <a class="carousel-control-prev" href="#carouselExampleIndicators" role="button" style="color:darkgrey" data-bs-slide="prev">
            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
            <span class="sr-only">Previous</span>
        </a>
        <a class="carousel-control-next" href="#carouselExampleIndicators" role="button" style="color:darkgrey" data-bs-slide="next">
            <span class="carousel-control-next-icon" aria-hidden="true"></span>
            <span class="sr-only">Next</span>
        </a>
    </div>

</div>
<h4>
    Klassebilleder
</h4>
@if (Model.ClassPhoto != null)
{
    @foreach (Photo cp in Model.ClassPhoto)
    {
        <img style="width:auto; max-height:500px" src="~/images/ClassPhotos/@cp.Filename" alt="Klasse billede" />

    }
}
else
{
    <p>Der er endnu ikke et klassebillede</p>
}
<br />
<br />
<h4>Alle billeder</h4>
@if (Model.Photos != null)
{
    <div class="row" style="display:flex; flex-wrap:wrap">
        <div class="column" style="flex:50%">
            @foreach (Photo p in Model.Photos)
            {
                <img style="width:auto; max-height:300px; " src="~/images/Portraits/@p.Filename" alt="Elev billede" />
            }
        </div>
    </div>
}



