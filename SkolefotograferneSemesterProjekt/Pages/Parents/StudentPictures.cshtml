@page
@using SkolefotograferneSemesterProjekt.Models
@model SkolefotograferneSemesterProjekt.Pages.Parents.StudentPicturesModel
@{
    ViewData["Title"] = "Student Pictures";
}

<h1> Pictures of @Model.TheStudent.FirstName </h1>

<p>
    The Parent is @Model.TheParent.FirstName With the email @Model.TheParent.Email <br/>
</p>

<div style="background-color:beige" id="carouselExampleIndicators" class="carousel slide" data-ride="carousel">
    <ol class="carousel-indicators">
        <li data-target="#carouselExampleIndicators" data-slide-to="0" class="active"></li>
        @for(int i = 1; i < Model.Photos.Count(); i++)
        {
            <li data-target="#carouselExampleIndicators" data-slide-to="@i" ></li>
        }
    </ol>
    <div class="carousel-inner">
        <div class="carousel-item active">
            <img style="margin:auto" class="d-block w-60" src="~/images/Portraits/@Model.Photos[0].Filename" alt="First slide">
        </div>
        @foreach(Photo p in @Model.Photos.Skip(1))
        {
            <div class="carousel-item">
                <img class="d-block w-100" src="~/images/Portraits/@p.Filename" alt="Slide">
            </div>
        }
    </div>
    <a class="carousel-control-prev" href="#carouselExampleIndicators" role="button" style="color:darkgrey"  data-slide="prev">
        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
        <span class="sr-only">Previous</span>
    </a>
    <a class="carousel-control-next" href="#carouselExampleIndicators" role="button" style="color:darkgrey" data-slide="next" >
        <span class="carousel-control-next-icon" aria-hidden="true"></span>
        <span class="sr-only">Next</span>
    </a>
</div>

<h4>
    The Class Photo
</h4>
@if (Model.ClassPhoto != null)
{
    @foreach (Photo cp in Model.ClassPhoto)
    {
        <img src="~images/ClassPhotos/@cp.Filename" alt="Class Photo" />
    
    }
}else
{
    <p>There is not a Class Photo yet</p>
}

