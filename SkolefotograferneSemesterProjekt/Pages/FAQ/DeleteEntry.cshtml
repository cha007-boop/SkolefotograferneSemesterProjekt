@page
@model SkolefotograferneSemesterProjekt.Pages.FAQ.DeleteEntryModel
@{
    ViewData["Title"] = "Slet FAQ-Indlæg";
}

<a asp-page="Index">Tilbage</a>
<p>Er du sikker på du vil slette indlægget?</p>

<form method="post">
    <input type="hidden" asp-for="EntryID" />
    
    <div class="form-group">
        <input type="submit" asp-page-handler="Delete" class="btn btn-danger" value="Slet" />
        <a asp-page="Index" class="btn btn-secondary">Fortryd</a>
    </div>
</form>