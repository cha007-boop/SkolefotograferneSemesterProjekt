@page
@model SkolefotograferneSemesterProjekt.Pages.FAQ.EditEntryModel
@{
    ViewData["Title"] = "Opdater entry";
}

<a asp-page="Index">Tilbage</a>
<h1 style ="text-align: center">Opdater Entry</h1>

<form method="post">
    <input type="hidden" asp-for="EntryID" />

    <div class="form-group">
        <label asp-for="@Model.NewEntry" class="control-label">Tekst</label>
        <input asp-for="@Model.NewEntry" class="form-control" />
        <span asp-validation-for="@Model.NewEntry" class="text-danger"></span>

        <div class="form-group mt-2">
            <input type="submit" value="Opdater" class="btn btn-primary" />
            <a asp-page="Index" class="btn btn-secondary">Fortryd</a>
        </div>
    </div>
</form>
