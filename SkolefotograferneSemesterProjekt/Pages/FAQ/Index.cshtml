@page
@model SkolefotograferneSemesterProjekt.Pages.FAQ.IndexModel
@{
    ViewData["Title"] = "FAQ";
}
<h1 style="text-align: center">FAQ</h1>
@if (Model.IsAdmin)
{
    <p>
        <a asp-page="AddEntry" class="btn btn-primary">Opret et nyt FAQ-indlæg</a>
    </p>
    <table class="table">
        <thead>
            <tr>
                <th>Spørgsmål</th>
                <th>Svar</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @for (int i = 0; i < Model.Entries.Count; i++)
            {
                <tr>
                    <td>@Model.Entries[i].Question</td>
                    <td>@Model.Entries[i].Answer</td>
                    <td>
                        <a asp-page="EditEntry" asp-route-id="@i">Opdater</a> |
                        <a asp-page="DeleteEntry" asp-route-id="@i">Slet</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    @foreach (var e in Model.Entries)
    {
        <div>
            <h2>@e.Question</h2>
            <p>@e.Answer</p>
        </div>
    }
}