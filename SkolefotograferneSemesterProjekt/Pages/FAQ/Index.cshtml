@page
@model SkolefotograferneSemesterProjekt.Pages.FAQ.IndexModel
@{
    ViewData["Title"] = "FAQ";
}
<h1 style="text-align: center">FAQ</h1>

@if (Model.IsAdmin)
{
    <p>
        <a asp-page="AddEntry" class="btn btn-primary">Opret et nyt FAQ-indlæg</a>
    </p>
    @for (int i = 0; i < Model.Entries.Count; i++)
    {
        <h2 class="costume-collapsible">@Model.Entries[i].Question</h2>
        <div class="content">
            <p>@Model.Entries[i].Answer</p>
        </div>
        <div class="form-group mt-2">
            <a asp-page="EditEntry" asp-route-id="@i" class="btn btn-primary btn-sm">Opdater</a>
            <a asp-page="DeleteEntry" asp-route-id="@i" class="btn btn-danger btn-sm">Slet</a>
        </div>
    }
}
else
{
    @foreach (var e in Model.Entries)
    {
        <h2 class="costume-collapsible">@e.Question</h2>
        <div class="content">
            <p>@e.Answer</p>
        </div>
    }

}

@* Used for the accordion *@
<script>
    document.addEventListener("click", function(event) {
        var trigger = event.target.closest(".costume-collapsible");

        if (!trigger) return;

        trigger.classList.toggle("active");

        var content = trigger.nextElementSibling;
        if (content && content.classList.contains("content")) {
            if (content.style.display === "block") {
                content.style.display = "none";
            } else {
                content.style.display = "block";
            }
        }
    });
</script>