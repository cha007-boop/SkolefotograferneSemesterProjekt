@page
@model SkolefotograferneSemesterProjekt.Pages.FAQ.IndexModel
@{
    ViewData["Title"] = "FAQ";
}
<h1 style="text-align: center">FAQ</h1>
@if (Model.IsAdmin)
{
    @* <h2><a asp-page="/FAQ">Opret et nyt spørgsmål</a></h2> *@
    <td>
        <input type="submit" asp-page-handler="" value="Opret et nyt spørgsmål" class="btn btn-primary" />
    </td>
    <table class="table">
        <thead>
            <tr>
                <th>Emner</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var e in Model.Entries)
            {
                int i = 0;
                <tr>
                    <td>@e</td>
                    <td>
                        <a asp-page="EditEntry" asp-route-id="@e[i]">Opdater</a> |
                        <a asp-page="DeleteEntry" asp-route-id="@e[i]">Slet</a>
                    </td>
                </tr>
                i++;
            }
        </tbody>
    </table>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Emner</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var e in Model.Entries)
            {
                <tr>
                    <td>@e</td>
                </tr>
            }
        </tbody>
    </table>
}
