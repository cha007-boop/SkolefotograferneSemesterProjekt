@page
@model SkolefotograferneSemesterProjekt.Pages.Photos.ViewPhotosModel
@{
    ViewData["Title"] = "ViewPhotos";
}

<div class="display-3">
    <h1>Photos</h1>
</div>

<div class="container mt-3">
    <div class="row">
        <div class="col">
            <form method="get">
                <input type="hidden" asp-for=SortColumn />
                <input type="hidden" asp-for=SortOrder />
                <div class="form-group">
                    search: <input type="text" asp-for="FilterValue" />
                    <select asp-for="FilterColumn" class="form-select d-inline-block" style="width:auto; margin-left:8px;">
                        <option value="All">-- Select Column --</option>
                        @foreach (var column in Model.FilterableColumns)
                        {
                            <option value="@column.Key">@column.Value</option>
                        }
                    </select>
                </div>
                <div class="form-group mt-3">
                    Type:
                    <select asp-for="Type" class="form-select d-inline-block" style="width:auto; margin-left:8px;">
                        <option value="All">All</option>
                        <option value="Portraits">Portraits</option>
                        <option value="ClassPhotos">Class Photos</option>
                    </select>
                </div>
                <div class="mt-2">
                    <input type="submit" value="Search" />
                </div>
            </form>
        </div>

    </div>
    <div class="row">
        <div class="col">
            <table class="table">
                <thead>
                    <tr>
                        <th></th>
                        @foreach (var column in Model.SortableColumns)
                        {
                            <th>
                                <a asp-page="./ViewPhotos"
                                   asp-route-FilterColumn="@Model.FilterColumn"
                                   asp-route-FilterValue="@Model.FilterValue"
                                   asp-route-SortColumn="@column.Key"
                                   asp-route-SortOrder="@Model.Toggle(column.Key)" class="text-decoration-none text-dark">
                                    @column.Value @(Model.SortColumn == column.Key ? (Model.SortOrder == "ASC" ? "▲" : "▼") : "")
                                </a>
                            </th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var photo in Model.Photos)
                    {
                        <tr>
                            <td>
                                <img src="~/images/@(photo.Child != null ? "Portraits" : "ClassPhotos")/@(photo.Filename)" class="img-thumbnail" style="height:60px;" />
                            </td>
                            <td>@photo.ThePhotoEvent.ID</td>
                            <td>@photo.ThePhotoEvent.TheSchoolAdmin.TheSchool.Name</td>
                            <td>@photo.TheSchoolClass.Grade  @(photo.TheSchoolClass.Letter ?? "")</td>
                            <td>@(photo.Child?.FirstName ?? "")</td>
                            <td>@(photo.Child?.Surname ?? "")</td>
                            <td>@photo.UploadedAt.ToString("G")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

</div>