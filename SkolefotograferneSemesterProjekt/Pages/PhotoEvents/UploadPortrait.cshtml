@page
@model SkolefotograferneSemesterProjekt.Pages.PhotoEvents.UploadPortraitModel
@{
    ViewData["Title"] = "Upload Portrætbillede";
}

<div>
    <h3 class="Display-3">
        Upload Portrætbillede for @Model.TheStudent.FirstName @Model.TheStudent.Surname
    </h3>
</div>

<div class="row">
    <div class="col-md-4">
        <form method="post" enctype="multipart/form-data">
            <input type="hidden" asp-for="@Model.TheStudent.ID" name="StudentId" />
            <input type="hidden" asp-for="@Model.ThePhotoEvent.ID" name="PhotoEventId" />
            <div class="form-group">
                <label asp-for="FileUpload.Files" class="control-label"></label>
                <div class="custom-file">
                    <input type="file" asp-for="FileUpload.Files" class="custom-file-input form-control" multiple>
                    <span asp-validation-for="FileUpload.Files" class="text-danger"></span>
                </div>
                <div class="formgroup mt-3">
                    <input asp-page-handler="UploadMulti" class="btn btn-primary" type="submit" value="Upload">
                </div>
            </div>
        </form>
        @{
            if (ViewData["SuccessMessage"] != null)
            {
                <span class="text-success"> @ViewData["SuccessMessage"]</span>
            }
        }

    </div>
</div>
<div class="row mt-3">
    <div class="col-md-4">
        <a asp-page="/PhotoEvents/PhotoEventDetails" asp-route-id="@Model.ThePhotoEvent.ID" class="btn btn-secondary">Tilbage Til Fotoeventet</a>
    </div>
</div>