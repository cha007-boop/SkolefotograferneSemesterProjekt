@page
@model SkolefotograferneSemesterProjekt.Pages.PhotoEvents.UploadPortraitModel
@{
    ViewData["Title"] = "Upload Portrait";
}

<div>
    <h3 class="Display-3">
        Upload Portrait for @Model.TheStudent.FirstName @Model.TheStudent.Surname
    </h3>
</div>

<div class="row">
    <div class="col-md-4">
        <form method="post" enctype="multipart/form-data">
            <input type="hidden" asp-for="@Model.TheStudent.ID" />
            <input type="hidden" asp-for="@Model.ThePhotoEvent.ID" />
            <div class="form-group">
                <label asp-for="@Model.Portrait" class="control-label"></label>
                <div class="custom-file">
                    <input asp-for="@Model.Portrait" class="custom-file-input form-control" />
                </div>
            </div>
            <div class="formgroup mt-3">
                <input type="submit" value="Upload" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>