@page
@using SkolefotograferneSemesterProjekt.Models
@model SkolefotograferneSemesterProjekt.Pages.PhotoEvents.ReadPhotoEventsModel
@{
    ViewData["Title"] = "Læs Fotoevents";
}
@inject IHttpContextAccessor HttpContextAccessor

<h1>Fotoevents</h1>

<form>
    @if (HttpContext.Session.GetInt32("Role") == 3 || HttpContext.Session.GetInt32("Role") == 4)
    {
        <div>
            <a asp-page="/PhotoEvents/CreatePhotoEvents" class="btn btn-primary">Opret Fotoevent</a>
        </div>
    }
    <br />
</form>
<form method="post">
    <div>
        <a asp-page="/Index" class="btn btn-primary">Tilbage til Startsiden</a>
    </div>
</form>
<br />


@if (HttpContext.Session.GetInt32("Role") == (int)UserRole.SysAdmin)
{
    <form method="get">
        search: <input type="text" asp-for="@Model.FilterCriteria" />
        <select asp-for="@Model.FilterBy" class="form-select d-inline-block" style="width:auto; margin-left:8px;">
            <option value="ID">Fotoevent ID</option>
            <option value="Year">Årgang</option>
            <option value="School">Skole</option>
            <option value="Photographer">Fotograf</option>
        </select>
    </form>
}

<form method="get">
    <input type="radio"
           asp-for="EventType"
           value="" />
    <label>Alle</label>
    <br />
    <input type="radio"
           asp-for="EventType"
           value="1" />
    <label>Aktive</label>
    <br />
    <input type="radio"
           asp-for="EventType"
           value="2" />
    <label>Tidligere</label>
    <br />
    <input type="submit" value="Filtrer Fotoevents" />
</form>
@if (Model.PhotoEvents.Count <= 0)
{
    <p class="display-6">Der er ingen Fotoevents</p>
}
else
{
    <h2>Fotoevents</h2>
    <table class="table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Skole</th>
                <th>Skolens Adresse</th>
                <th>Skolens Postnummer</th>
                <th>Antal Studerende</th>
                <th>Start Tidspunkt</th>
                <th>Slut Tidspunkt</th>
                <th>Fotograf</th>
                <th>Lokation</th>
                <th></th>
            </tr>
        </thead>
        @foreach (var photoEventItem in Model.PhotoEvents)
        {
            <tbody>
                <tr>
                    <td>@photoEventItem.ID</td>
                    <td>@photoEventItem.TheSchoolAdmin.TheSchool.Name</td>
                    <td>@photoEventItem.TheSchoolAdmin.TheSchool.Street</td>
                    <td>@photoEventItem.TheSchoolAdmin.TheSchool.ZipCode</td>
                    <td>@photoEventItem.TheSchoolAdmin.TheSchool.StudentCount</td>
                    <td>@photoEventItem.StartTime</td>
                    <td>@photoEventItem.EndTime</td>
                    <td>@photoEventItem.ThePhotographer.FirstName @photoEventItem.ThePhotographer.Surname</td>
                    <td>@photoEventItem.Location</td>
                    <td>
                        @if (HttpContext.Session.GetInt32("Role") != 0 && HttpContext.Session.GetInt32("Role") != 2)
                        {
                            <a asp-page="/Photoevents/PhotoEventDetails" class="btn btn-primary" asp-route-id="@photoEventItem.ID">Info</a>
                        }
                    </td>
                    @if (HttpContext.Session.GetInt32("Role") == 3 && photoEventItem.StartTime > DateTime.Now || HttpContext.Session.GetInt32("Role") == 4)
                    {
                        <td><button type="button" class="btn btn-danger" onclick="DisplayConfirmDeleteModal('@photoEventItem.ID')">Slet Fotoevent</button></td>
                    }
                    @if(HttpContext.Session.GetInt32("Role") == (int)UserRole.Teacher && photoEventItem.StartTime > DateTime.Now)
                    {
                        <td>
                            <a asp-page="/Bookings/CreateBooking" asp-route-id="@photoEventItem.ID" class="btn btn-primary">Book</a>
                        </td>
                    }
                </tr>
            </tbody>
        }
    </table>

}


<form method="post" asp-page-handler="DeletePhotoEvents" id="deleteForm">
    <input type="hidden" name="id" id="deleteId" />
</form>

<div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">

            <div class="modal-header bg-warning">
                <h5 class="modal-title">Confirm Delete</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <p>Er du sikker på at du vil slette dette Fotoevent?</p>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    Annuller
                </button>

                <button type="button" class="btn btn-danger" id="confirmDeleteBtn">
                    Slet
                </button>
            </div>

        </div>
    </div>
</div>


@section Scripts {
    <script>
        function DisplayConfirmDeleteModal(id) {
            document.getElementById("deleteId").value = id;

            var modal = new bootstrap.Modal(document.getElementById('deleteModal'));
            modal.show();
        }

        document.getElementById("confirmDeleteBtn").addEventListener("click", function () {
            document.getElementById("deleteForm").submit();
        });
    </script>
}