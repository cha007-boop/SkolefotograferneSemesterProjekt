@page "{id:int}"
@model SkolefotograferneSemesterProjekt.Pages.PhotoEvents.PhotoEventDetailsModel
@{
    ViewData["Title"] = "Fotoevent Detaljer";
}

<div>
    <h3 class="Display-3">
        Fotoevent @Model.ThePhotoEvent.ID
    </h3>
</div>

<div>
    <div class="row">
        <div class="col">
            <form>
                <a asp-page="./UpdatePhotoEvent" asp-route-id="@Model.ThePhotoEvent.ID" class="btn btn-primary">Rediger Fotoevent</a>
            </form>

            <div>
                <p><strong>Skole:</strong> @Model.ThePhotoEvent.TheSchoolAdmin.TheSchool.Name</p>
                <p><strong>Skolens Adresse:</strong> @Model.ThePhotoEvent.TheSchoolAdmin.TheSchool.Street @Model.ThePhotoEvent.TheSchoolAdmin.TheSchool.ZipCode</p>
                <p><strong>Booking Dato:</strong> @Model.ThePhotoEvent.StartTime.ToShortDateString() - @Model.ThePhotoEvent.EndTime.ToShortDateString()</p>
                <p><strong>Antal Klasser:</strong> @Model.SchoolClasses.Count()</p>
                <p><strong>Antal Lærerer:</strong> @Model.SchoolClasses.Select(c => c.TheTeacher).Distinct().Count()</p>
            </div>
        </div>
    </div>

    <div class="row mt-3">
        <div class="col-8">
            <form method="get">
                <input type="hidden" name="Id" value="@Model.Id" />
                <select asp-for="SelectedClassId" class="form-select d-inline-block" style="width:auto; margin-left:8px;">
                    <option value="">-- Vælg Klasse --</option>
                    @foreach (var schoolClass in Model.SchoolClasses)
                    {
                        <option value="@schoolClass.ID">@schoolClass.Grade @schoolClass.Letter</option>
                    }
                </select>
                <input type="submit" class="btn btn-primary" value="Vælg" />
            </form>
        </div>
        @if (!string.IsNullOrEmpty(Model.SelectedClassId) && Model.SelectedClassId != "0" && (HttpContext.Session.GetInt32("Role") == 1 || HttpContext.Session.GetInt32("Role") == 4))
        {
            <div class="col-4">
                <a asp-page="./UploadClassPhoto"
                   asp-route-photoeventid="@Model.Id"
                   asp-route-schoolclassid="@Model.SelectedClassId" class="btn btn-secondary">
                    Upload Klassebillede
                </a>
            </div>
        }
    </div>
    <div class="row">
        <div>
            @if(Model.Students.Count == 0)
            {
                <p class="display-6">Ingen billeder er blevet uploadet</p>
            }
            else
            {
                <table class="table">
                    <thead>
                        <tr>
                            <th>Klasse</th>
                            <th>Studerendes ID</th>
                            <th>Studerende</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var student in Model.Students)
                        {
                            <tr>
                                <td>@student.TheSchoolClass.Grade @student.TheSchoolClass.Letter</td>
                                <td>@student.ID</td>
                                <td>@student.FirstName @student.Surname</td>
                                @if (HttpContext.Session.GetInt32("Role") == 1 || HttpContext.Session.GetInt32("Role") == 4)
                                {
                                    <td>
                                        <a asp-page="./UploadPortrait"
                                           asp-route-photoeventid="@Model.Id"
                                           asp-route-studentid="@student.ID" class="btn btn-secondary">
                                            Upload Portrætbillede
                                        </a>
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
</div>

<div>
    <a asp-page="/PhotoEvents/ReadPhotoEvents">Tilbage til Fotoevents</a>
</div>
