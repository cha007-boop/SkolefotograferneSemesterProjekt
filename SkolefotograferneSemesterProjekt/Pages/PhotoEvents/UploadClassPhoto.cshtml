@page
@model SkolefotograferneSemesterProjekt.Pages.PhotoEvents.UploadClassPhotoModel
@{
    ViewData["Title"] = "Upload Klassebillede";
}

<div>
    <h3 class="Display-3">
        Upload Klassebillede for @Model.TheSchoolClass.Grade @Model.TheSchoolClass.Letter
    </h3>
</div>

<div class="row">
    <div class="col-md-4">
        <form method="post" enctype="multipart/form-data">
            <input type="hidden" asp-for="@Model.TheSchoolClass.ID" />
            <input type="hidden" asp-for="@Model.ThePhotoEvent.ID" />
            <div class="form-group">
                <label asp-for="@Model.Photos" class="control-label"></label>
                <div class="custom-file">
                    <input asp-for="@Model.Photos" class="custom-file-input form-control" multiple />
                </div>
            </div>
            <div class="formgroup mt-3">
                <input type="submit" value="Opload" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>
<div class="row mt-3">
    <div class="col-md-4">
        <a asp-page="/PhotoEvents/PhotoEventDetails" asp-route-id="@Model.ThePhotoEvent.ID" class="btn btn-secondary">Tilbage Til Fotoeventet</a>
    </div>
</div>
