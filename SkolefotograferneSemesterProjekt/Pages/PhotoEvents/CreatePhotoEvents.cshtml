@page
@model SkolefotograferneSemesterProjekt.Pages.PhotoEvents.CreatePhotoEventsModel
@{
    ViewData["Title"] = "Opret Fotoevent";
}

<h1>Opret Fotoevent</h1>

<form method="post">
    <div class="form-group">
        <label asp-for="@Model.PhotoEvent.StartTime" class="control-label"></label>
        <input asp-for="@Model.PhotoEvent.StartTime" class="form-control"/>
        <span asp-validation-for="PhotoEvent.StartTime" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="@Model.PhotoEvent.EndTime" class="control-label"></label>
        <input asp-for="@Model.PhotoEvent.EndTime" class="form-control" />
        <span asp-validation-for="PhotoEvent.EndTime" class="text-danger"></span>
    </div>

    <div class="form-group">
        <h6>Fotograf ID</h6>
        <select asp-for="PhotographerID"
                asp-items="@Model.Photographers"
                id="photographerSelect"
                class="form-select">
            <option value="">-- Vælg Fotograf --</option>
        </select>
        <span asp-validation-for="PhotoEvent.ThePhotographer.ID" class="text-danger"></span>
    </div>
    @if (HttpContext.Session.GetInt32("Role") == 4)
    {
        <h6>Skolesekretær ID</h6>
        <div class="form-group">
            <select asp-for="SchoolAdminID"
                    asp-items="@Model.SchoolAdmins"
                    id="schoolAdminSelect"
                    class="form-select">
                <option value="">-- Vælg Skolesekretær --</option>
            </select>
            <span asp-validation-for="PhotoEvent.TheSchoolAdmin.ID" class="text-danger"></span>
        </div>
    }

    <div class="form-group">
        <label asp-for="@Model.PhotoEvent.Location" class="control-label"></label>
        <input asp-for="@Model.PhotoEvent.Location" class="form-control" />
        <span asp-validation-for="PhotoEvent.Location" class="text-danger"></span>
    </div>
    <div class="form-group">
        <input type="submit" value="Opret Fotoevent" class="btn btn-primary" />
    </div>

    <div>
        <a asp-page="ReadPhotoEvents">Tilbage til Fotoevents</a>
    </div>

    </form>