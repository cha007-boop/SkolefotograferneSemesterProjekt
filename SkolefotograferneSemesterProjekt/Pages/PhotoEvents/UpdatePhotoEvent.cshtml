@page
@model SkolefotograferneSemesterProjekt.Pages.PhotoEvents.UpdatePhotoEventModel
@{
    ViewData["Title"] = "Update PhotoEvent";
}

<h4>The PhotoEvent that is chosen:</h4>

<table class="table">
    <thead>
        <tr>
            <th>ID</th>
            <th>StartTime</th>
            <th>EndTIme</th>
            <th>Photographer</th>
            @if (HttpContext.Session.GetInt32("Role") != 3)
            {
                <th>SchoolAdminID</th>
            }
            <th>Location</th>
        </tr>
    </thead>
    <tbody>
            <tr>
                <td>@Model.PhotoEvent.ID</td>
                <td>@Model.PhotoEvent.StartTime</td>
                <td>@Model.PhotoEvent.EndTime</td>
                <td>@Model.PhotoEvent.ThePhotographer.FirstName @Model.PhotoEvent.ThePhotographer.Surname</td>
                @if (HttpContext.Session.GetInt32("Role") != 3)
                {
                    <td>@Model.PhotoEvent.TheSchoolAdmin.ID</td>
                }
                <td>@Model.PhotoEvent.Location</td>
            </tr>
    </tbody>
</table>

<form method="post">
 <input type="hidden" asp-for="@Model.PhotoEvent.ID"/>
    <div class="form-group">
        <label asp-for="@Model.PhotoEvent.StartTime" class="control-label"></label>
        <input asp-for="@Model.PhotoEvent.StartTime" class="form-control" />
        <span asp-validation-for="PhotoEvent.StartTime" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="@Model.PhotoEvent.EndTime" class="control-label"></label>
        <input asp-for="@Model.PhotoEvent.EndTime" class="form-control" />
        <span asp-validation-for="PhotoEvent.EndTime" class="text-danger"></span>
    </div>

    <div class="form-group">
        <h6>PhotographerID</h6>
        <select asp-for="@Model.PhotoEvent.ThePhotographer.ID"
                asp-items="@Model.Photographers"
                id="photographerSelect"
                class="form-select">
            <option value="">-- Select Photographer --</option>
        </select>
        <span asp-validation-for="PhotoEvent.ThePhotographer.ID" class="text-danger"></span>
    </div>
    <div class="form-group">
        @if (HttpContext.Session.GetInt32("Role") == 3)
        {
            <p hidden>@HttpContext.Session.GetInt32("ID")</p>
        }
        else
        {
            <h6>SchoolAdminID</h6>
            <select asp-for="@Model.PhotoEvent.TheSchoolAdmin.ID"
                    asp-items="@Model.SchoolAdmins"
                    id="schoolAdminSelect"
                    class="form-select">
                <option value="">-- Select SchoolAdmin --</option>
            </select>
            <span asp-validation-for="PhotoEvent.TheSchoolAdmin.ID" class="text-danger"></span>
        }
    </div>

    <div class="form-group">
        <label asp-for="@Model.PhotoEvent.Location" class="control-label"></label>
        <input asp-for="@Model.PhotoEvent.Location" class="form-control" />
        <span asp-validation-for="PhotoEvent.Location" class="text-danger"></span>
    </div>
    <div class="form-group">
        <input type="submit" value="Click here to Update the PhotoEvent" class="btn btn-primary" />
    </div>

    <div>
        <a asp-page="/Photoevents/PhotoEventDetails" asp-route-id="@Model.PhotoEvent.ID">Back to Details</a>
    </div>
</form>