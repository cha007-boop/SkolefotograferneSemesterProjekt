@page
@model SkolefotograferneSemesterProjekt.Pages.Teachers.DeleteTeacherModel
@{
    ViewData["Title"] = "Slet Bruger (Lærer)";
}

<h1>Slet Bruger</h1>
<form method="post">
    <label>Navn</label>: @Model.TeacherToDelete!.FirstName<br/>
    <label>Efternavn</label>: @Model.TeacherToDelete.Surname<br/>
    
    <div class="form-group d-flex gap-2 mt-3">
        <input type="submit" asp-page-handler="Delete" asp-route-id="@Model.TeacherToDelete.ID" class="btn btn-danger" value="Slet" />
        <input type="submit" asp-page-handler="" class="btn btn-secondary" value="Fortryd" />
    </div>
</form>