@page
@using SkolefotograferneSemesterProjekt.Models
@model SkolefotograferneSemesterProjekt.Pages.Teachers.ViewSchoolClassesModel
@{
    ViewData["Title"] = "Se skoleklasser";
}

@if (Model.ClassList.Count < 1)
{
    <span class="display-2">
        @(Model.Role == (int)UserRole.Teacher ? "Du har ingen klasser..." : "Ingen klasser at vise...")
    </span>
    @if (Model.Role == (int)UserRole.Teacher)
    {
        <a asp-page="/SchoolClasses/AddSchoolClass" class="btn btn-primary">Opret en skoleklasse</a>
    }
}
else
{
    <div class="row">
        <div class="col">
            <h1>Skoleklasser</h1>

            <div class="form-group d-flex gap-2 mt-3">
                @if (Model.Role == (int)UserRole.Teacher)
                {
                    <a asp-page="/SchoolClasses/AddSchoolClass" class="btn btn-primary">Opret en ny skoleklasse</a>
                }

            </div>
        </div>
    </div>
    <div class="row">
        <div class="col">
            <table class="table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Klasse</th>
                        <th>Årgang</th>
                        @if (Model.Role == (int)UserRole.SysAdmin)
                        {
                            <th>Skole ID</th>
                            <th>Skole</th>
                        }
                        <th></th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (SchoolClass sc in Model.ClassList)
                    {
                        <tr>
                            <td>@sc.ID</td>
                            <td>@(sc.Grade + "." + sc.Letter)</td>
                            <td>@sc.SchoolYear</td>
                            @if (Model.Role == (int)UserRole.SysAdmin)
                            {
                                <td>@sc.TheSchool.ID</td>
                                <td>@sc.TheSchool.Name</td>
                                <td>
                                    <a asp-page="/SchoolClasses/UpdateSchoolClass" asp-route-id="@sc.ID" class="btn btn-primary">Opdater</a>
                                </td>
                            }
                            <form method="post" asp-page-handler="Delete">
                            <td><button type="button" class="btn btn-danger" onclick="DisplayConfirmDeleteModal('@sc.ID')">Slet</button></td>
                            </form>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

}


<form method="post" asp-page-handler="Delete" id="deleteForm">
    <input type="hidden" name="id" id="deleteId" />
</form>

<div class="modal fade" id="deleteClassModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">

            <div class="modal-header bg-warning">
                <h5 class="modal-title">Bekræft sletning</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <p>Er du sikker på, at du vil slette denne klasse?</p>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    Annuller
                </button>

                <button type="button" class="btn btn-danger" id="confirmDeleteBtn">
                    Slet
                </button>
            </div>

        </div>
    </div>
</div>
@section Scripts {
    <script>
        function DisplayConfirmDeleteModal(id) {
            document.getElementById("deleteId").value = id;

            var modal = new bootstrap.Modal(document.getElementById('deleteClassModal'));
            modal.show();
        }

        document.getElementById("confirmDeleteBtn").addEventListener("click", function () {
            document.getElementById("deleteForm").submit();
        });
    </script>
}
@if (HttpContext.Session.GetInt32("Role") == 3)
{
    <div>
        <a asp-page="/Teachers/Index">Tilbage til liste af lærer</a>
    </div>
}
@if (HttpContext.Session.GetInt32("Role") == 2)
{
    <div>
        <a asp-page="/Index">Tilbage til forside</a>
    </div>
}