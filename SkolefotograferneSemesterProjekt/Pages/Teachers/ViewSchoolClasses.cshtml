@page
@using SkolefotograferneSemesterProjekt.Models
@model SkolefotograferneSemesterProjekt.Pages.Teachers.ViewSchoolClassesModel
@{
    ViewData["Title"] = "Se Skole klasser";
}

@if(Model.ClassList.Count < 1 && Model.IsUser)
{
    <div>
        <a asp-page="Index">Tilbage</a>
    </div>

    <h1>Du har ingen klasser...</h1>
}
else if(Model.ClassList.Count < 1 && Model.Role == 4)
{
    <div>
        <a asp-page="Index">Tilbage</a>
    </div>

    <h1>Denne lære har ingen klasser...</h1>
}
else if (Model.IsUser)
{
    <div>
        <a asp-page="Index">Tilbage</a>
    </div>

    <table class="table">
        <thead>
            <tr>
                <form method="get">
                <th>Klasse</th>
                <th>Årgang</th>
                </form>
            </tr>
        </thead>
        <tbody>
            @foreach (SchoolClass sc in Model.ClassList)
            {
                <tr>
                    <td>@(sc.Grade + "." + sc.Letter)</td>
                    <td>@sc.SchoolYear</td>
                </tr>
            }
        </tbody>
    </table>
}
else if(Model.Role == 4)
{
    <div>
        <a asp-page="Index">Tilbage</a>
    </div>

    <table class="table">
        <thead>
            <tr>
                <form method="get">
                <th>ID</th>
                <th>Klasse</th>
                <th>Årgang</th>
                <th>Skole ID</th>
                <th>Skole</th>
                </form>
            </tr>
        </thead>
        <tbody>
            @foreach (SchoolClass sc in Model.ClassList)
            {
                <tr>
                    <td>@sc.ID</td>
                    <td>@(sc.Grade + "." + sc.Letter)</td>
                    <td>@sc.SchoolYear</td>
                    <td>@sc.TheSchool.ID</td>
                    <td>@sc.TheSchool.Name</td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div>
        <a asp-page="Index">Tilbage</a>
    </div>

    <h1>Access denied...</h1>
}

