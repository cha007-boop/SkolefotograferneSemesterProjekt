@page
@using SkolefotograferneSemesterProjekt.Models
@model SkolefotograferneSemesterProjekt.Pages.Teachers.IndexModel
@{
    ViewData["Title"] = "Index (Lærer)";
}

@if (Model.Role == (int)UserRole.SysAdmin)
{
    @if(Model.TeacherFList.Count() > 0)
    {
        <form method="get">
            <input type="text" asp-for="@Model.FilterCriteria" />
            <select asp-for="@Model.FilterBy" class="form-select d-inline-block" style="width:auto; margin-left:8px;">
                <option value="t.TheSchool.Name">Skole</option>
                <option value="t.Email">Mail</option>
            </select>

            <input type="submit" value="Søg" />
        </form>
    }

    <p>
        <a asp-page="CreateTeacher">Opret en lærer</a>
    </p>

    <a asp-page="/Teachers/ViewSchoolClasses" class="btn btn-primary">Se klasser</a>
    @if (Model.TeacherFList.Count() <= 0)
    {
        <p class="display-6">Der er i øjeblikket ingen lærere tilknyttet denne skole</p>
    }
    else
    {
        <table class="table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Navn</th>
                    <th>Efternavn</th>
                    <th>Mail</th>
                    <th>Telefon</th>
                    <th>Skole ID</th>
                    <th>Skole</th>
                    <th></th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (Teacher t in Model.TeacherFList)
                {
                    <tr>
                        <td>@t.ID</td>
                        <td>@t.FirstName</td>
                        <td>@t.Surname</td>
                        <td>@t.Email</td>
                        <td>@t.PhoneNumber</td>
                        <td>@t.TheSchool.ID</td>
                        <td>@t.TheSchool.Name</td>
                        <td>
                            <a asp-page="EditTeacher" asp-route-id="@t.ID">Opdater</a> |
                            <a asp-page="DeleteTeacher" asp-route-id="@t.ID">Slet</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
}
else if (Model.Role == (int)UserRole.SchoolAdmin)
{
    <form method="get">
        Søg: <input type="text" asp-for="@Model.FilterCriteria" />
        <select asp-for="@Model.FilterBy" class="form-select d-inline-block" style="width:auto; margin-left:8px;">
            <option value="t.FirstName">Navn</option>
            <option value="t.Email">Mail</option>
        </select>

        <input type="submit" value="Søg" />
    </form>

    <p>
        <a asp-page="CreateTeacher">Opret en lærer</a>
    </p>

    <table class="table">
        <thead>
            <tr>
                <th>Navn</th>
                <th>Efternavn</th>
                <th>Mail</th>
                <th>Telefon</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (Teacher t in Model.TeacherFList)
            {
                <tr>
                    <td>@t.FirstName</td>
                    <td>@t.Surname</td>
                    <td>@t.Email</td>
                    <td>@t.PhoneNumber</td>
                    <td>
                        <a asp-page="/Teachers/ViewSchoolClasses" asp-route-id="@t.ID" class="btn btn-primary">Se klasser</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else if (Model.IsUser)
{
    <table class="table">
        <thead>
            <tr>
                <th>Navn</th>
                <th>Efternavn</th>
                <th>Mail</th>
                <th>Telefon</th>
                <th>Skole</th>  
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>@Model.TheTeacher.FirstName</td>
                <td>@Model.TheTeacher.Surname</td>
                <td>@Model.TheTeacher.Email</td>
                <td>@Model.TheTeacher.PhoneNumber</td>
                <td>@Model.TheTeacher.TheSchool.Name</td>
                <td>
                    <a asp-page="EditTeacher" asp-route-id="@Model.TheTeacher.ID">Opdater</a> |
                    <a asp-page="DeleteTeacher" asp-route-id="@Model.TheTeacher.ID">Slet</a>
                </td>
                <td>
                    <a asp-page="/Teachers/ViewSchoolClasses" asp-route-id="@Model.TheTeacher.ID" class="btn btn-primary">Se klasser</a>
                </td>
            </tr>
        </tbody>
    </table>
}
else
{
    <h1 style="text-align: center;">Adgang nægtet...</h1>
    
    <h2 style="text-align: center">
        <a asp-page="CreateTeacher">Opret en bruger</a>
    </h2>
}

<div>
    <a asp-page="/Index">Tilbage til forsiden</a>
</div>